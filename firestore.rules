rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasAccount() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return hasAccount() ? ownUser().data.role : 'user'; }
    function isAdmin() { return role() == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function canEditProfile(profile) {
      return isAdmin() || isOwner(profile.data.createdByUid) ||
        (signedIn() && request.auth.uid in profile.data.editorIds);
    }

    function validCautions(cautions) {
      return cautions is list && cautions.hasOnly([
        'Firearm Offender', 'Drug Offender', 'Violent', 'Breaker',
        'Sexual Offender', 'Murderer'
      ]);
    }

    function canEditCautionsAndNotes() {
      return hasAccount() &&
        request.resource.data.cautions is list &&
        validCautions(request.resource.data.cautions) &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 255 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cautions', 'notes', 'lastEditedByUid', 'lastEditedByOfficerName', 'lastEditedAt'
        ]) &&
        request.resource.data.lastEditedByUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' ||
        (
          request.resource.data.role == 'admin' &&
          request.resource.data.adminSetupCode is string &&
          exists(/databases/$(database)/documents/system/bootstrap) &&
          get(/databases/$(database)/documents/system/bootstrap).data.enabled == true &&
          request.resource.data.adminSetupCode == get(/databases/$(database)/documents/system/bootstrap).data.code
        )
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.officerName == resource.data.officerName &&
        request.resource.data.email == resource.data.email
      );

      allow delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.editorIds is list &&
        request.resource.data.address is string &&
        request.resource.data.address.size() <= 255 &&
        request.resource.data.lastEditedByUid == request.auth.uid;

      allow update: if (
        canEditCautionsAndNotes() ||
        (canEditProfile(resource) &&
          (
            isAdmin() || (
              request.resource.data.createdByUid == resource.data.createdByUid &&
              request.resource.data.editorIds == resource.data.editorIds
            )
          ) && request.resource.data.lastEditedByUid == request.auth.uid)
      );

      allow delete: if isAdmin();
    }

    // One-time first administrator bootstrap. The web app cannot read this document.
    match /system/bootstrap {
      allow get, list: if false;
      allow create: if false;
      allow update: if signedIn() &&
        resource.data.enabled == true &&
        request.resource.data.enabled == false &&
        request.resource.data.code == resource.data.code &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false;
    }
  }
}